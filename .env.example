# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# The Kyiv broker (D58): the login and the topic of a claimed node (meshtastic.kyiv.ua, its node page).
KYIV_MQTT_HOST=mqtt.meshtastic.kyiv.ua
KYIV_MQTT_TLS=false
KYIV_MQTT_ROOT=node/<node id, 8 hex digits>
KYIV_MQTT_USER=
KYIV_MQTT_PASSWORD=
MESH_MQTT_USER=
MESH_MQTT_PASSWORD=
KYIV_PRIMARY_PSK=
MESH_FAMILY_PSK=
MESH_KYIV_PRIVATE_KEY=
BRIAR_AUTH_TOKEN=
BRIAR_PASSWORD=
# The community broker of the owner's login (D62), when used instead of the Kyiv broker:
WIKIMESH_MQTT_HOST=mqtt.wikimesh.in.ua
WIKIMESH_MQTT_TLS=false
WIKIMESH_MQTT_ROOT=kyiv
WIKIMESH_MQTT_USER=
WIKIMESH_MQTT_PASSWORD=
WIKIMESH_PRIVATE_PSK=
